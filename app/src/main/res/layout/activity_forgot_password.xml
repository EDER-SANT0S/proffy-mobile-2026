<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
    tools:context=".ui.forgotPassword.ForgotPasswordActivity"
    android:background="@color/background_white">

    <ScrollView
        android:id="@+id/scrollViewForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/containerBackgroundForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:background="@color/purple"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/imageBackgroundForgotPassword"
                    android:layout_width="238dp"
                    android:layout_height="266dp"
                    android:src="@drawable/background_2"
                    android:layout_centerInParent="true" />

                <ImageView
                    android:id="@+id/imageIntroForgotPassword"
                    android:layout_width="160dp"
                    android:layout_height="80dp"
                    android:src="@drawable/intro"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <ImageButton
                android:id="@+id/buttonGoBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="@string/forgot_password_back_description"
                app:layout_constraintTop_toBottomOf="@+id/containerBackgroundForgotPassword"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@null"
                android:layout_marginTop="16dp"
                android:layout_marginStart="20dp" />

            <TextView
                android:id="@+id/textViewTitleForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password_title"
                app:layout_constraintTop_toBottomOf="@+id/buttonGoBack"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="30dp"
                android:layout_marginStart="32dp"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="24sp"
                android:textColor="@color/text_title" />

            <TextView
                android:id="@+id/textViewSubtitleForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password_subtitle"
                app:layout_constraintTop_toBottomOf="@+id/textViewTitleForgotPassword"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginStart="32dp"
                android:fontFamily="@font/poppins"
                android:lineSpacingExtra="4dp"
                android:textSize="14sp"
                android:textColor="@color/text_base" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/textViewSubtitleForgotPassword"
                android:layout_marginTop="40dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                style="@style/CustomFilledTextFieldEmail"
                android:hint="@string/forgot_password_hint_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditEmail"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:textColor="@color/text_base"
                    android:textAppearance="@font/poppins"
                    android:textSize="16sp"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonSend"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/forgot_password_button_default"
                android:enabled="false"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayoutEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/shape_disable"
                android:textColor="@color/text_complement"
                android:textSize="16sp"
                android:fontFamily="@font/archivo_semibold"
                android:elevation="0dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
